# /etc/turaes/edge.env — environment for the standalone edge (Pingora) service.
# The edge reads control routes/certs over gRPC and owns :80/:443.

# Control-plane gRPC (reach it over the VPC / loopback) + shared join token.
TURAES_CONTROL_URL=http://10.0.0.2:9443
TURAES_AGENT_TOKEN=change-me

# Proxy listeners + certificate layout.
TURAES_PROXY_HTTP_PORT=80
TURAES_PROXY_HTTPS_PORT=443
TURAES_CERT_DIR=/etc/letsencrypt/live
TURAES_ACME_WEBROOT=/var/lib/turaes/acme

# Dashboard host (derived from public_url) + wildcard base domain.
TURAES_PUBLIC_URL=https://turaes.rayakala.ink
TURAES_BASE_DOMAIN=rayakala.ink
# Address the edge uses to reach the control plane for the dashboard route.
TURAES_PROXY_CONTROL_ADDRESS=10.0.0.2

TURAES_LOG=info
