[Unit]
Description=turaes deployment platform (docker-less self-hosted PaaS)
Documentation=https://github.com/maulanasly/turaes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# turaes generates systemd units for the apps it manages and owns :80/:443 via
# Pingora, so it runs as root. Switch to the `proc` runtime + DynamicUser to
# drop privileges (see docs/DEPLOY.md).
User=root
WorkingDirectory=/var/lib/turaes
EnvironmentFile=-/etc/turaes/turaes.env
ExecStart=/usr/local/bin/turaes serve
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
# Sandbox the control plane. It still runs as root (it writes app units,
# installs binaries and binds :80/:443), but the filesystem, devices, kernel
# interfaces and namespaces are locked down to what it needs: unit/binary/env
# writes under /etc and /usr/local, D-Bus + journal sockets (AF_UNIX),
# loopback/VPC traffic (AF_INET/AF_INET6) and interface lookups (AF_NETLINK).
ProtectSystem=strict
# Writable paths mirror the runtime defaults (bin/unit/env/state dirs). If the
# [runtime] dirs are relocated, extend this list to match.
ReadWritePaths=/var/lib/turaes /etc /usr/local/bin
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
