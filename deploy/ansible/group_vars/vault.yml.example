---
# GitHub OAuth — create the OAuth App at
# https://github.com/settings/developers with callback
#   https://{turaes_domain}/auth/callback
# and set the values below, then encrypt with:
#   ansible-vault edit deploy/ansible/group_vars/vault.yml
# Get your numeric id with `gh api user -q .id`.
turaes_github_client_id: ""
turaes_github_client_secret: ""
turaes_allowed_github_ids: ""
# Shared fleet secret: agents and edges present it to the control plane's gRPC
# Register/EdgeRoutes (must match TURAES_AGENT_TOKEN on agents and edges).
turaes_agent_join_token: ""
