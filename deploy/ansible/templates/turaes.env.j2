# /etc/turaes/turaes.env — rendered by the turaes ansible role.
# Installed with mode 0600. Never commit real values.

# --- required ---
TURAES_JWT_SECRET={{ turaes_jwt_secret }}
{% if turaes_secret_previous is defined and turaes_secret_previous %}
TURAES_SECRET_PREVIOUS={{ turaes_secret_previous }}
{% endif %}
TURAES_GITHUB_CLIENT_ID={{ turaes_github_client_id }}
TURAES_GITHUB_CLIENT_SECRET={{ turaes_github_client_secret }}
TURAES_ALLOWED_GITHUB_IDS={{ turaes_allowed_github_ids }}
TURAES_APP_ORIGIN={{ turaes_app_origin }}

# --- storage ---
TURAES_DATABASE_URL=sqlite:///var/lib/turaes/turaes.db?mode=rwc
TURAES_BACKUP_DIR=/var/lib/turaes/backups
TURAES_BACKUP_RETAIN=14

# --- proxy (Pingora) ---
TURAES_PROXY_ENABLED={{ 'true' if turaes_proxy_enabled else 'false' }}
TURAES_PROXY_HTTP_PORT=80
TURAES_PROXY_HTTPS_PORT=443
TURAES_CERT_DIR={{ turaes_cert_dir }}
TURAES_ACME_WEBROOT={{ turaes_acme_webroot }}
{% if turaes_control_address is defined and turaes_control_address %}
# Address agents/edges dial for gRPC and artifact fetch, and the edge uses for
# the dashboard route.
TURAES_PROXY_CONTROL_ADDRESS={{ turaes_control_address }}
{% endif %}

# --- fleet channel (multi-node) ---
TURAES_GRPC_ENABLED={{ 'true' if turaes_grpc_enabled else 'false' }}
TURAES_GRPC_PORT={{ turaes_grpc_port }}
TURAES_AGENT_JOIN_TOKEN={{ turaes_agent_join_token }}
{% if turaes_host is defined and turaes_host %}
# Reachable by agents for artifact fetch; keep the cloud SG scoped to the VPC.
TURAES_HOST={{ turaes_host }}
{% endif %}

# --- runtime ---
TURAES_RUNTIME_DRIVER=systemd
TURAES_UNIT_DIR=/etc/systemd/system
TURAES_BIN_DIR={{ turaes_bin_dir }}
TURAES_STATE_DIR=/var/lib
TURAES_ENV_DIR=/etc

# --- logging ---
TURAES_LOG=info
