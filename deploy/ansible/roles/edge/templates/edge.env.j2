# /etc/turaes/edge.env — rendered by the edge ansible role.
# Installed with mode 0600. Never commit real values.

# Control-plane gRPC + shared join token (same secret as the agent join token).
TURAES_CONTROL_URL=http://{{ turaes_control_address }}:{{ turaes_grpc_port }}
TURAES_AGENT_TOKEN={{ turaes_agent_join_token }}

# Proxy listeners + certificate layout (edge writes pulled certs here).
TURAES_PROXY_HTTP_PORT=80
TURAES_PROXY_HTTPS_PORT=443
TURAES_CERT_DIR={{ turaes_cert_dir }}
TURAES_ACME_WEBROOT={{ turaes_acme_webroot }}
{% if turaes_edge_reuse_port %}
# Allow two edge instances to bind :80/:443 for a zero-downtime rolling replace.
TURAES_PROXY_REUSE_PORT=true
{% endif %}

# Dashboard host + wildcard base domain.
TURAES_PUBLIC_URL={{ turaes_edge_public_url }}
TURAES_BASE_DOMAIN={{ turaes_base_domain }}
# Address the edge uses to reach the control plane for the dashboard route.
TURAES_PROXY_CONTROL_ADDRESS={{ turaes_control_address }}

TURAES_LOG=info
