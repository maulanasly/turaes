# /etc/turaes/turaes.env — secrets and environment overrides for turaes.
# Installed with mode 0600. Never commit real values.
#
# Precedence: embedded defaults < turaes.toml < these environment variables.

# --- required ---------------------------------------------------------------
TURAES_JWT_SECRET=replace-with-openssl-rand-hex-32
TURAES_GITHUB_CLIENT_ID=
TURAES_GITHUB_CLIENT_SECRET=
# Numeric GitHub user ids allowed to sign in (comma-separated; not usernames).
TURAES_ALLOWED_GITHUB_IDS=
# Canonical dashboard origin. Must match the OAuth callback {origin}/auth/callback.
TURAES_APP_ORIGIN=https://turaes.rayakala.ink

# --- storage ----------------------------------------------------------------
TURAES_DATABASE_URL=sqlite:///var/lib/turaes/turaes.db?mode=rwc

# --- listener ---------------------------------------------------------------
#TURAES_HOST=0.0.0.0
#TURAES_PORT=8787

# --- proxy (Pingora) --------------------------------------------------------
# Requires a build with `--features turaes-proxy/pingora`.
TURAES_PROXY_ENABLED=false
#TURAES_PROXY_HTTP_PORT=80
#TURAES_PROXY_HTTPS_PORT=443
TURAES_CERT_DIR=/etc/letsencrypt/live

# --- runtime ----------------------------------------------------------------
TURAES_RUNTIME_DRIVER=systemd
#TURAES_UNIT_DIR=/etc/systemd/system
#TURAES_BIN_DIR=/usr/local/bin
#TURAES_STATE_DIR=/var/lib
#TURAES_ENV_DIR=/etc

# --- monitoring -------------------------------------------------------------
#TURAES_MONITOR_INTERVAL_SECS=15
#TURAES_MONITOR_RETENTION_DAYS=30

# --- logging ----------------------------------------------------------------
#TURAES_LOG=info
